{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "writing-ai-cpu",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "ai/writing/Start-Writing.ps1", "-Device", "cpu"],
      "env": { "HF_HUB_OFFLINE": "1", "TRANSFORMERS_OFFLINE": "1" },
      "port": 8000
    },
    {
      "name": "backend",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "backend/EnglishLearning.Api", "--launch-profile", "http"],
      "env": { "WritingAi__AutoStart": "false" },
      "port": 5000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "env": { "SPEAKING_AUTO_START": "0" },
      "port": 3000
    }
  ]
}
