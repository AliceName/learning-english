{
  "Jwt": {
    "Issuer": "EnglishLearning.Api",
    "Audience": "EnglishLearning.Web",
    "AccessTokenMinutes": 30,
    "SessionHours": 8
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
