@HostAddress = http://localhost:5000

### Application health
GET {{HostAddress}}/api/v1/health
Accept: application/json

### SQL Server connection (read only)
GET {{HostAddress}}/api/v1/health/database
Accept: application/json

### Register an account (creates a real user)
POST {{HostAddress}}/api/v1/auth/register
Content-Type: application/json

{
  "email": "learner@example.com",
  "fullName": "Người học tiếng Anh",
  "password": "Learning@2026",
  "confirmPassword": "Learning@2026",
  "targetLevel": "B1"
}

### Login (copy accessToken into the variable below to test /me)
POST {{HostAddress}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "learner@example.com",
  "password": "Learning@2026"
}

### Current account requires a valid Bearer token
@AccessToken = paste-a-local-test-token-here
GET {{HostAddress}}/api/v1/auth/me
Authorization: Bearer {{AccessToken}}

### Course catalog (published system courses and your own uploads)
GET {{HostAddress}}/api/v1/courses?sort=updated&page=1&pageSize=6
Authorization: Bearer {{AccessToken}}

### Combined filters (level + skill match the same active lesson)
GET {{HostAddress}}/api/v1/courses?search=English&level=B1&skill=speaking&status=in_progress&source=system&sort=popular
Authorization: Bearer {{AccessToken}}

### Course details (use an ID from the list)
@CourseId = 1

### Admin: create a draft with initial Speaking and Listening lessons
POST {{HostAddress}}/api/v1/admin/courses
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "title": "Workplace English",
  "description": "Speaking and listening for everyday meetings.",
  "coverImageUrl": "https://example.com/cover.jpg",
  "difficultyLevel": "B2",
  "estimatedMinutes": 25,
  "skills": ["speaking", "listening"]
}

### Admin: generate American IPA without storing a lesson
POST {{HostAddress}}/api/v1/admin/pronunciation/ipa
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "text": "Could you tell me how to get to the library?"
}

### Admin: inspect saved draft and lesson IDs
GET {{HostAddress}}/api/v1/admin/courses/{{CourseId}}
Authorization: Bearer {{AccessToken}}

### Admin: publish after completing active lessons
POST {{HostAddress}}/api/v1/admin/courses/{{CourseId}}/publish
Authorization: Bearer {{AccessToken}}

### Admin: add a Grammar lesson (after database script 003)
POST {{HostAddress}}/api/v1/admin/courses/{{CourseId}}/lessons
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "title": "Present Perfect",
  "skillType": "grammar",
  "difficultyLevel": "B1",
  "estimatedMinutes": 20,
  "grammar": {
    "topic": "Present Perfect",
    "rules": "S + have/has + V3/ed",
    "commonMistakes": "Do not use with yesterday.",
    "questions": [{
      "type": "fill_blank",
      "prompt": "She [blank] (work) here since 2020.",
      "answer": "has worked",
      "acceptedAnswers": ["'s worked"],
      "explanation": "Use present perfect with since + a starting point."
    }]
  }
}

### Student: course details
GET {{HostAddress}}/api/v1/courses/{{CourseId}}
Authorization: Bearer {{AccessToken}}
